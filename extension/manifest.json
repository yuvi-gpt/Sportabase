{
  "name": "Sportabase",
  "version": "0.2.1",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://sportabase-api.onrender.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sportabase",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "settings.html",
  "description": "AI-powered intelligence for sports articles and videos, including summaries, credibility signals, and multilingual analysis.",
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sportabase-logo.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
