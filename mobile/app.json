{
  "expo": {
    "name": "Sportabase",
    "slug": "sportabase",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/sportabase-logo.png",
    "scheme": "sportabase",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/sportabase-logo.png",
      "bundleIdentifier": "com.sportabase.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050807",
        "foregroundImage": "./assets/images/sportabase-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sportabase.app",
      "versionCode": 1,
      "icon": "./assets/images/sportabase-logo.png",
      "backgroundColor": "#050807"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050807",
          "image": "./assets/images/sportabase-logo.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain"
            ],
            "multipleShareMimeTypes": []
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#050807",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e868b0ee-a5e2-441f-86e6-333abebd9565"
      }
    },
    "owner": "yuvigpt"
  }
}
